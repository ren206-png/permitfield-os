# Supabase. NEXT_PUBLIC_* names are required by Next.js's own client-bundling
# convention, not overridden by the PERMITFIELD_ prefix below (that prefix
# applies to this app's own config, not framework-mandated variable names).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely -- never expose to the client, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# AI (SS2). claude-sonnet-5 lives as one exported constant in lib/ai/config.ts
# (Phase 2+) -- this key is the only AI-related env var, the model ID is not
# configured via env.
ANTHROPIC_API_KEY=

# Embeddings. Anthropic serves no embeddings endpoint (SS2); Phase 0 proposes
# Voyage AI voyage-3 / 1024 dims -- see PHASE_0_FINDINGS.md SS5, unconfirmed.
VOYAGE_API_KEY=

# Background jobs (SS2) -- required starting Phase 2, not used by Phase 1 migrations.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Feature flags -- all default OFF per the global engineering rule (SS1).
# Set to "true" to enable in a given environment.
PERMITFIELD_FF_AI_AUDIT=false
PERMITFIELD_FF_PDF_FILL=false
PERMITFIELD_FF_VECTOR_RETRIEVAL=false
# Lifecycle & Compliance Expansion, Phase 1.0. Gates nothing yet -- see
# lib/flags.ts's isLifecycleCoreEnabled() header comment.
PERMITFIELD_FF_LIFECYCLE_CORE=false
# Lifecycle & Compliance Expansion, Phase 1.1. Gates the project intake UI
# (app/(app)/projects/new/) -- see lib/flags.ts's isIntakeEnabled() header
# comment.
PERMITFIELD_FF_INTAKE=false
# Lifecycle & Compliance Expansion, Phase 1.2. Gates nothing yet -- see
# lib/flags.ts's isJurisdictionsEnabled() header comment.
PERMITFIELD_FF_JURISDICTIONS=false
# Lifecycle & Compliance Expansion, Phase 1.3. Gates nothing yet -- see
# lib/flags.ts's isApplicationsEnabled() header comment.
PERMITFIELD_FF_APPLICATIONS=false

# Storage buckets (SS0.9) -- private, signed-URL-only (SS4.1).
PERMITFIELD_STORAGE_BUCKET_UPLOADS=permitfield-uploads
PERMITFIELD_STORAGE_BUCKET_GENERATED=permitfield-generated
